# Reference only. Export these variables in your shell; .env is NOT auto-loaded.
# The deterministic demo needs none of these.
# SPROUT_API_KEY=your-provider-key
# SPROUT_API_BASE=https://api.openai.com/v1
# SPROUT_MODEL=your-compatible-model
# SPROUT_CODEX_MODEL=your-local-codex-model
# SPROUT_CODEX_COMMAND=codex
# SPROUT_DATA_PATH=/absolute/path/to/local/project-storage
# SPROUT_ALLOWED_ORIGINS=http://localhost:5173
# GRAPHCODE_SERVER_PORT=3010
# GRAPHCODE_WEB_PORT=5173
